# The basics
export XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}
export EDITOR=nvim

export ZSH_CACHE_DIR="$HOME/.cache"

# Keep PATH/fpath free of duplicates: .zprofile and .zshrc both prepend entries,
# and login+interactive shells run both.
typeset -U path PATH fpath

# Plugins. HOMEBREW_PREFIX is already exported by `brew shellenv` in .zprofile;
# the fallback is only for shells that somehow skipped it, since `brew --prefix`
# forks a Ruby process (~40ms).
source "${HOMEBREW_PREFIX:-$(brew --prefix)}/opt/antidote/share/antidote/antidote.zsh"
antidote load

# Load external config
source "$HOME/code/vinibaggio-dotfiles/zsh/aliases"
[ -f "$HOME/code/vinibaggio-private/zsh/zshrc" ] && source "$HOME/code/vinibaggio-private/zsh/zshrc"

# Load my own scripts
export PATH="$PATH:$HOME/code/vinibaggio-dotfiles/bin"

# If 1password agent file is present, set it as the ssh-agent
if [ -e $HOME/.1password/agent.sock ]; then
	export SSH_AUTH_SOCK=$HOME/.1password/agent.sock
fi

# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
eval "$(mise activate zsh)"
export PATH="$HOME/.local/bin:$PATH"

# Added by LM Studio CLI (lms)
export PATH="$PATH:$HOME/.lmstudio/bin"
# End of LM Studio CLI section

# LM Studio local API token (loaded from 1Password)
if command -v op >/dev/null 2>&1; then
  export LM_API_TOKEN="$(op read 'op://Private/LM_API_TOKEN/credential' 2>/dev/null)"
fi

# Pi local LM Studio shortcut
alias pilocal='pi --provider lm-studio --model google/gemma-4-e4b-pi-32k'

eval "$(fasder --init auto aliases)"
eval "$(zoxide init zsh)"
